# Local .terraform directories
.terraform/
**/.terraform/*
.terraform*
!.terraform-docs.yaml

# Terraform state
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Sensitive variable files are intentionally not used in this template.
*.tfvars
*.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plans
tfplan
*.tfplan

# CLI configuration
.terraformrc
terraform.rc

# Test/build artifacts
.kitchen/
vendor/
coverage.out

